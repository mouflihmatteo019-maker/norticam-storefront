# Public storefront settings only. Never place Admin API/private Storefront tokens here.
VITE_SITE_URL=https://norticam.com
VITE_SHOPIFY_DOMAIN=z4a1f0-p0.myshopify.com
# Optional PUBLIC Storefront token; tokenless access currently works.
VITE_SHOPIFY_PUBLIC_TOKEN=
# URL-prefix Search Console property verification (or verify Domain via DNS yourself).
VITE_GOOGLE_SITE_VERIFICATION=
# Leave unset until measurement properties and consent settings are verified.
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=
# Preproduction review visual pass: leave false for any deploy. Local development enables it automatically.
VITE_PREPROD_REVIEWS=false
# Public URL of a secure server endpoint only. It must verify order number + email server-side with Shopify access.
VITE_ORDER_TRACKING_ENDPOINT=
# For prerender/tests: chrome if using an installed browser; otherwise install Chromium.
BROWSER_CHANNEL=
