{% doc %}Secure native Shopify order access. No order lookup or private API in the browser.{% enddoc %}
<section class="bg-slate-950 py-16 text-white sm:py-20"><div class="container max-w-4xl"><p class="eyebrow text-[#75b8ff]">{{ 'tracking.kicker' | t }}</p><h1 class="mt-4 font-display text-4xl font-extrabold tracking-[-.055em] sm:text-6xl">{{ 'tracking.title' | t }}</h1><p class="mt-5 max-w-xl leading-7 text-slate-300">{{ 'tracking.intro' | t }}</p></div></section>
<section class="container max-w-4xl py-12 sm:py-16"><div class="grid gap-8 sm:grid-cols-2">
<div class="rounded-[1.7rem] bg-white p-6 sm:p-8">
{% if shop.customer_accounts_enabled %}<h2 class="font-display text-2xl font-extrabold">{{ 'tracking.account_title' | t }}</h2><p class="mt-4 leading-7 text-slate-600">{{ 'tracking.account_copy' | t }}</p><a class="btn-primary mt-6" href="{{ routes.account_url }}">{{ 'tracking.account_cta' | t }}</a>{% endif %}
<h2 class="mt-6 font-display text-xl font-extrabold">{{ 'tracking.email_title' | t }}</h2><p class="mt-4 leading-7 text-slate-600">{{ 'tracking.email_copy' | t }}</p></div>
<aside class="rounded-[1.7rem] border border-slate-200 p-6 sm:p-8"><h2 class="font-display text-2xl font-extrabold">{{ 'tracking.shipping_title' | t }}</h2><p class="mt-4 leading-7 text-slate-600">{{ 'tracking.shipping_copy' | t }}</p><a class="mt-6 inline-block font-bold text-[#1672d8]" href="{{ routes.root_url }}pages/informations-livraison-retours">{{ 'tracking.shipping_link' | t }}</a></aside></div>
<div class="mt-8 rounded-[1.7rem] bg-white p-6 sm:p-8"><h2 class="font-display text-2xl font-extrabold">{{ 'tracking.help_title' | t }}</h2><p class="mt-4 leading-7 text-slate-600">{{ 'tracking.help_copy' | t }}</p><a class="btn-secondary mt-6" href="{{ routes.root_url }}pages/contact">{{ 'tracking.support' | t }}</a></div></section>
