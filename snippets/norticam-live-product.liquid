{% doc %}Live initial product content for products added after compilation. React enhances this with the existing NORTICAM product page.{% enddoc %}
{% assign current_variant = product.selected_or_first_available_variant %}
<section class="bg-[#f7f8f9] pb-24 pt-5 sm:pb-14 sm:pt-9"><div class="container">
<a href="{{ routes.all_products_collection_url }}" class="mb-5 inline-flex items-center gap-1.5 text-sm font-bold text-slate-500">{{ 'product.back' | t }}</a>
<div class="grid gap-8 lg:grid-cols-[1.06fr_.94fr] lg:gap-14">
<div class="min-w-0 lg:sticky lg:top-24 lg:self-start"><div class="relative overflow-hidden rounded-[2rem] bg-[#e8ebed] shadow-[0_15px_35px_rgba(15,23,42,.07)]"><div class="aspect-square">
{% assign main_image = current_variant.featured_image | default: product.featured_image %}
{% if main_image %}{{ main_image | image_url: width: 1000 | image_tag: widths: '320,480,640,800,1000', sizes: '(min-width:1024px) 40vw, (min-width:640px) 50vw, 100vw', class: 'h-full w-full object-contain', loading: 'eager', fetchpriority: 'high' }}{% endif %}
</div></div></div>
<div class="min-w-0 max-w-xl"><p class="eyebrow">{{ product.vendor | escape }}</p><h1 class="mt-3 font-display text-4xl font-extrabold leading-[.98] tracking-[-.055em] text-slate-950 sm:text-5xl">{{ product.title | escape }}</h1>
<div class="mt-7 flex items-end justify-between border-y border-slate-200 py-5"><p class="font-display text-4xl font-extrabold tracking-tight text-slate-950">{{ current_variant.price | money }}</p><p class="text-sm">{% if current_variant.available %}{{ 'product.available' | t }}{% else %}{{ 'product.unavailable' | t }}{% endif %}</p></div>
{% form 'product', product %}
<label for="live-variant" class="mt-5 block text-sm font-bold">{{ 'product.configuration' | t }}</label><select id="live-variant" name="id" class="mt-2 block w-full rounded-xl border bg-white p-3">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}</option>{% endfor %}</select>
<button class="btn-primary mt-6 w-full" type="submit" {% unless product.available %}disabled{% endunless %}>{{ 'product.add' | t }}</button>
{% endform %}
<div class="mt-3 flex flex-wrap justify-center gap-2">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'h-7 w-11' }}{% endfor %}</div>
<div class="norticam-richtext mt-8">{{ product.description }}</div>
</div></div></div></section>
